# ─────────────────────────────────────────────
# LiveSense — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# HuggingFace token (free account required for pyannote)
HF_TOKEN=hf_your_token_here

# Deepgram API key — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Audio
CHUNK_MS=512
SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ASR
WHISPER_MODEL=small

# Device: auto | cpu | mps | cuda
DEVICE=auto

# Sentiment fusion weights (must sum to 1.0)
FUSION_ALPHA=0.6

# Translation
TRANSLATE_ENABLED=false
SOURCE_LANG=auto
TARGET_LANG=en

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=livesense

# File uploads
UPLOAD_DIR=/tmp/livesense_uploads
MAX_UPLOAD_MB=500
